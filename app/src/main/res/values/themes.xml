<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тема запуска: системная заставка с неподвижным значком: анимации до Android 12 нет, затем обычная тема. -->
    <style name="Theme.Will.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/will_background</item>
        <!-- Фон под полосами рисует сама заставка — маской телефона, поэтому он не обрезается. -->
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1440</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>
</resources>
