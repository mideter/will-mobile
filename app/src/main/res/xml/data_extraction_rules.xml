<?xml version="1.0" encoding="utf-8"?>
<!-- Ничего из приложения не уходит ни в облачный бэкап, ни на другой телефон: токен
     устройства — это тело человека на сервере, и копию его не держат нигде. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
